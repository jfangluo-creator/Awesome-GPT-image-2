---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery';
import ThemeToggle from '../components/ThemeToggle';
import caseData from '../data/cases.json';

const { totalCases, categories, tagGroups, cases } = caseData;

// cases.json 里 image 字段已包含 "images/" 前缀，这里只给 BASE_URL
const imageBase = import.meta.env.BASE_URL;
---

<BaseLayout>
  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-[var(--color-border)] backdrop-blur-xl" style="background: color-mix(in srgb, var(--color-bg) 85%, transparent)">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🎨</span>
        <div>
          <h1 class="text-lg font-bold leading-tight">Awesome GPT Image</h1>
          <p class="text-xs text-[var(--color-text-secondary)]">
            {totalCases} 个精选案例 · {categories.length} 大分类 · {tagGroups.reduce((s, g) => s + g.tags.length, 0)} 个标签
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="https://www.xsearch.icu/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
          title="XSearch 多媒体创作平台"
        >
          <img src="/xsearch-icon.svg" alt="XSearch" class="w-5 h-5" />
        </a>
        <a
          href="https://github.com/jfangluo-creator/Awesome-GPT-image-2"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
          title="GitHub 仓库"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <ThemeToggle client:load />
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 pb-12">
    <Gallery
      client:load
      cases={cases}
      categories={categories}
      tagGroups={tagGroups}
      imageBase={imageBase}
    />
  </main>

  <!-- Footer -->
  <footer class="border-t border-[var(--color-border)] py-6 text-center text-sm text-[var(--color-text-secondary)]">
    <p>
      🎨 Awesome GPT Image Gallery ·
      <a href="https://github.com/jfangluo-creator/Awesome-GPT-image-2" target="_blank" class="text-accent-500 hover:underline">
        GitHub
      </a>
    </p>
  </footer>
</BaseLayout>
